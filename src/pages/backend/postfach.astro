---
// Booking inbox: the crew reads and answers booking@ without leaving the
// backend. Mail lives in Gmail, see src/lib/mailbox.ts. Not for subs.
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import {
  VIEWS,
  VIEW_LABEL,
  assigneeNames,
  canUseMailbox,
  listThreads,
  mailboxDemo,
  mailboxReady,
  type MailView,
  type ThreadPage,
} from '../../lib/mailbox';

if (!canUseMailbox(Astro.locals.user)) return Astro.redirect('/backend');

const params = Astro.url.searchParams;
const view: MailView = VIEWS.find((v) => v === params.get('view')) ?? 'inbox';
const search = (params.get('q') ?? '').trim();
const pageToken = params.get('page') ?? '';

let page: ThreadPage = { threads: [], nextPageToken: null };
let failed = false;
let assignees = new Map<string, string>();
if (mailboxReady) {
  try {
    page = await listThreads(view, search, pageToken);
    assignees = await assigneeNames(page.threads.map((t) => t.id));
  } catch (err) {
    console.error('[postfach]', err);
    failed = true;
  }
}

const tz = 'Europe/Berlin';
const fmtDate = (ms: number) =>
  new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: tz }).format(new Date(ms));
const viewUrl = (v: MailView) => `/backend/postfach?view=${v}`;
const olderUrl = () => {
  const next = new URLSearchParams({ view, page: page.nextPageToken ?? '' });
  if (search) next.set('q', search);
  return `/backend/postfach?${next}`;
};
---

<Layout title="Postfach — Swallow's Rose Crew" chrome={false}>
  <section class="mx-auto min-h-[100dvh] max-w-3xl px-6 py-16">
    <a href="/backend" class="mb-8 inline-block text-xs uppercase tracking-[0.2em] text-cream-soft transition-colors hover:text-flame">
      ← Crew-Bereich
    </a>

    <p class="mb-2 text-xs uppercase tracking-[0.3em] text-flame">booking@swallowsrose.com</p>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="text-5xl">Postfach</h1>
      <a
        href="/backend/postfach/neu"
        class="rounded-lg bg-flame px-5 py-2.5 font-display text-base uppercase tracking-wide text-ink transition-colors hover:bg-flame-soft"
      >
        Neue Mail
      </a>
    </div>

    {mailboxDemo && (
      <p class="mt-4 rounded-lg border border-cream/15 p-3 text-sm text-cream-soft">Lokale Demo: Beispiel-Mails, es wird nichts wirklich verschickt.</p>
    )}

    {!mailboxReady ? (
      <p class="mt-8 text-cream-soft">Das Postfach ist noch nicht eingerichtet.</p>
    ) : (
      <>
        <form method="get" action="/backend/postfach" role="search" class="mt-8">
          <input type="hidden" name="view" value={view} />
          <label for="mail-search" class="sr-only">Mails durchsuchen</label>
          <input
            id="mail-search"
            name="q"
            type="search"
            value={search}
            placeholder="Suchen … (Name, Betreff, Text)"
            autocomplete="off"
            class="w-full rounded-lg border border-cream/15 bg-ink px-4 py-3 text-cream outline-none placeholder:text-cream/30 focus:border-flame"
          />
        </form>

        <nav aria-label="Ordner" class="mt-3 flex flex-wrap gap-2">
          {VIEWS.map((v) => (
            <a
              href={viewUrl(v)}
              aria-current={v === view ? 'page' : undefined}
              class:list={[
                'rounded-full border px-3 py-2 text-xs uppercase tracking-[0.15em] transition-colors',
                v === view ? 'border-flame text-flame' : 'border-cream/15 text-cream-soft hover:border-flame',
              ]}
            >
              {VIEW_LABEL[v]}
            </a>
          ))}
        </nav>

        {failed && <p class="mt-8 text-flame">Die Mails konnten gerade nicht geladen werden. Bitte die Seite neu laden.</p>}

        {!failed && page.threads.length === 0 && (
          <p class="mt-8 text-cream-soft">{search ? 'Nichts gefunden.' : 'Hier liegt gerade nichts.'}</p>
        )}

        <ul class="mt-6 space-y-2">
          {page.threads.map((thread) => (
            <li>
              <a
                href={`/backend/postfach/${encodeURIComponent(thread.id)}`}
                class:list={[
                  'block rounded-xl border p-4 transition-colors hover:border-flame',
                  thread.unread ? 'border-flame/50 bg-flame/10' : 'border-cream/15',
                ]}
              >
                <div class="flex items-baseline justify-between gap-3">
                  <p class:list={['min-w-0 truncate', thread.unread ? 'font-semibold text-cream' : 'text-cream-soft']}>
                    {thread.unread && <span class="sr-only">Ungelesen: </span>}
                    {thread.from}{thread.count > 1 && <span class="text-cream-soft"> ({thread.count})</span>}
                  </p>
                  <time class="shrink-0 text-xs text-cream-soft" datetime={new Date(thread.date).toISOString()}>{fmtDate(thread.date)}</time>
                </div>
                <p class:list={['mt-1 truncate', thread.unread ? 'font-semibold text-cream' : 'text-cream']}>{thread.subject}</p>
                <p class="mt-1 truncate text-sm text-cream-soft">{thread.snippet}</p>
                {assignees.get(thread.id) && <p class="mt-2 text-xs text-teal">Bei {assignees.get(thread.id)}</p>}
              </a>
            </li>
          ))}
        </ul>

        {page.nextPageToken && (
          <a href={olderUrl()} class="mt-6 inline-block text-sm text-teal transition-colors hover:text-flame">Ältere Mails →</a>
        )}
      </>
    )}
  </section>
</Layout>
